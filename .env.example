# NeoMint OS — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=neomint-planner

# ── Logging ───────────────────────────────────────────────────
NEOMINT_LOG_LEVEL=INFO

# ── Safety ────────────────────────────────────────────────────
# Require user confirmation before destructive operations
NEOMINT_CONFIRM_DESTRUCTIVE=true

# ── Agent Loop Limits ─────────────────────────────────────────
# Maximum actions per plan (1-5)
NEOMINT_MAX_ACTIONS_PER_PLAN=5

# Maximum planning loop steps per request
NEOMINT_MAX_LOOP_STEPS=3

# Model inference timeout (seconds)
NEOMINT_MODEL_TIMEOUT_SECONDS=60

# Per-tool execution timeout (seconds)
NEOMINT_TOOL_TIMEOUT_SECONDS=30

# ── Filesystem Scopes ─────────────────────────────────────────
# Comma-separated allowed filesystem roots
NEOMINT_ALLOWED_FS_ROOTS=~/Documents,~/Downloads,~/Desktop,~/Pictures

# ── Audit Log ─────────────────────────────────────────────────
# Path to the JSONL audit log file
# NEOMINT_AUDIT_LOG_PATH=~/.local/share/neomint/audit.jsonl

# ── Agent API Server ─────────────────────────────────────────
NEOMINT_AGENT_HOST=127.0.0.1
NEOMINT_AGENT_PORT=8420
